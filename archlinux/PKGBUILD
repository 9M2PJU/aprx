pkgname=aprx
pkgver=2.9.1
pkgrel=1
pkgdesc="APRS Digipeater and iGate"
arch=('x86_64')
url="https://github.com/9M2PJU/aprx"
license=('BSD')
depends=('openssl' 'perl')
source=("aprx-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir"
  cd aprx-*
  ./configure --prefix=/usr --sysconfdir=/etc --sbindir=/usr/bin --mandir=/usr/share/man
  make
}

package() {
  cd "$srcdir"
  cd aprx-*
  make DESTDIR="$pkgdir" install
}
